# Flask Application Environment Configuration Template
# Copy this file to .env for local testing (do NOT commit .env with real credentials)

# Flask Secret Key for Session & Cookie Security
SECRET_KEY=your-secure-production-secret-key-here

# Database Connection URL (supports PostgreSQL, MySQL, SQLite)
# PostgreSQL Format: postgresql://username:password@localhost:5432/database_name
# MySQL Format: mysql://username:password@localhost:3306/database_name
# SQLite Format: sqlite:///airodrone.db
DATABASE_URL=postgresql://username:password@localhost:5432/airodrone_db

# Optional Admin Default Password (for initial setup)
ADMIN_DEFAULT_PASSWORD=your-secure-admin-password

# Optional Server Port
PORT=5000
