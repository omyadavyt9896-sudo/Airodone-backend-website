# Flask Application Environment Configuration Template
# Copy this file to .env for local testing (do NOT commit .env with real credentials)

# Flask Secret Key for Session & Cookie Security
SECRET_KEY=your-secure-production-secret-key-here

# Database Connection URL (supports PostgreSQL, MySQL, SQLite)
# PostgreSQL Format: postgresql://username:password@localhost:5432/database_name
# MySQL Format: mysql://username:password@localhost:3306/database_name
# SQLite Format: sqlite:///airodrone.db
DATABASE_URL=postgresql://username:password@localhost:5432/airodrone_db

# Optional Admin Default Password (for initial setup)
ADMIN_DEFAULT_PASSWORD=your-secure-admin-password

# Optional Server Port
PORT=5000

# ==============================================================================
# Persistent Video Storage Configuration (Hostinger / Local / S3 / R2)
# ==============================================================================
# Storage Backend Selection: 'local' (default for development/tests) or 'hostinger' (for production)
STORAGE_BACKEND=local
HOSTINGER_STORAGE_ENABLED=false

# Transfer Protocol: 'sftp' (preferred SSH over port 22) or 'ftps' / 'ftp' (over port 21)
HOSTINGER_TRANSFER_PROTOCOL=sftp

# Hostinger SFTP / FTP Connection Details
# Obtain from Hostinger hPanel -> Advanced -> SSH Access / FTP Accounts
HOSTINGER_SFTP_HOST=your-hostinger-hostname-or-ip
HOSTINGER_SFTP_PORT=22
HOSTINGER_SFTP_USERNAME=your-hostinger-sftp-username
HOSTINGER_SFTP_PASSWORD=your-hostinger-sftp-password

# Remote Base Storage Path on Hostinger (e.g. storage or /home/u123456789/storage)
HOSTINGER_SFTP_BASE_PATH=storage

# Maximum Video Upload Size in Megabytes (default: 500 MB)
HOSTINGER_MAX_VIDEO_SIZE_MB=500
